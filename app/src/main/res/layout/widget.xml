<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño del widget: fondo oscuro redondeado, punto de color, caudal grande y % de Eugui -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="10dp"
    android:background="@drawable/widget_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Río Arga" android:textColor="#93A4B5" android:textSize="12sp" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/wDot" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="●" android:textSize="18sp" android:textColor="#3CCF7A" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/wQ" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="#E6EDF3" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text=" m³/s" android:textColor="#E6EDF3" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/wT" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#93A4B5" android:textSize="11sp" />
    <TextView android:id="@+id/wPct" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#7CC4FF" android:textSize="12sp" />
</LinearLayout>
